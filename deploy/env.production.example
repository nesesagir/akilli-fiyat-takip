# Production environment template (Render / Vercel / Neon).
# Copy values into each platform's dashboard. Do not commit secrets.

# Neon
ConnectionStrings__DefaultConnection=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin
Admin__Email=admin@example.com
Admin__Password=
Admin__DisplayName=Admin
Admin__ResetPasswordOnStartup=false

# Email (e.g. Gmail app password)
Email__Enabled=true
Email__Host=smtp.gmail.com
Email__Port=587
Email__UseSsl=true
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=Akıllı Fiyat Takip

# CORS — your frontend URL
Cors__Origins__0=https://your-app.vercel.app

# Auto price check (BackgroundService — do not use Hangfire on Neon/Render)
Hangfire__Enabled=false
PriceCheck__Enabled=true
PriceCheck__IntervalMinutes=30

# Vercel
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
